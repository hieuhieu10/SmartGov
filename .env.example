POSTGRES_DB=officeai
POSTGRES_USER=officeai
POSTGRES_PASSWORD=replace-with-a-strong-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=System Administrator
AI_INTERNAL_TOKEN=replace-with-a-long-random-token
JWT_SECRET=replace-with-a-long-random-secret
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL_NAME=your-model
VLLM_API_KEY=
VLLM_FALLBACK_BASE_URL=
VLLM_FALLBACK_MODEL_NAME=
VLLM_FALLBACK_API_KEY=
# Optional: Gemini is used only to detect and structure charts in chat responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_GEMINI_BASE_URL=
CHAT_SCANNER_TIMEOUT=20
OCR_VLLM_BASE_URL=http://host.docker.internal:8686/v1
OCR_VLLM_MODEL_NAME=your-vision-model
OCR_VLLM_API_KEY=
# Local self-hosted embedding service (default):
EMBEDDING_BASE_URL=http://embedding:7997/v1
EMBEDDING_MODEL_NAME=dangvantuan/vietnamese-embedding
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CHUNK_SIZE=800
EMBEDDING_MAX_CHARS=800

# Alternative: HuggingFace Inference API (cloud fallback):
# EMBEDDING_BASE_URL=https://api-inference.huggingface.co/models/dangvantuan/vietnamese-embedding
# EMBEDDING_MODEL_NAME=dangvantuan/vietnamese-embedding
# EMBEDDING_API_KEY=hf-your-huggingface-token
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_CHUNK_SIZE=800
# EMBEDDING_MAX_CHARS=800

RAG_TOP_K=8
RAG_VECTOR_CANDIDATES=30
RAG_TEXT_CANDIDATES=30
RAG_VECTOR_WEIGHT=0.6
RAG_TEXT_WEIGHT=1.4
